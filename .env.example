# Скопируйте в .env для локального запуска (`make run-api`).
# В dev-режиме .env читается автоматически; переменные окружения имеют приоритет.

APP_ENV=dev
LOG_LEVEL=debug
HTTP_PORT=8080
HTTP_MAX_UPLOAD_MB=10
HTTP_RATE_LIMIT_PER_MIN=30

# Секрет JWT. В prod обязателен и должен быть длинным и случайным:
#   openssl rand -base64 48
JWT_SECRET=dev-insecure-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

POSTGRES_DSN=postgres://emotion:emotion@localhost:5432/emotionsense?sslmode=disable
POSTGRES_MIGRATE_ON_START=true

REDIS_ADDR=localhost:6379

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=faces

# Снаружи Docker Kafka доступна на EXTERNAL-листенере 9094
KAFKA_BROKERS=localhost:9094
KAFKA_TOPIC=image.uploaded
KAFKA_DLQ_TOPIC=image.failed
KAFKA_CONSUMER_GROUP=emotion-workers

ML_ADDR=localhost:50051
ML_TIMEOUT=20s

WORKER_CONCURRENCY=4
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BASE=2s
